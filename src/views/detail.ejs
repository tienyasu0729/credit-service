<%
  const app = application || {};
  const docsJson = app.documentsJson || {};
  const rawPayload = app.rawPayloadJson || {};
  const snapshot = app.snapshotJson || rawPayload.applicationSnapshot || {};

  function toLabel(key) {
    const map = {
      CCCD_FRONT: 'CCCD/CMND mặt trước',
      CCCD_BACK: 'CCCD/CMND mặt sau',
      HOUSEHOLD_REG: 'Sổ hộ khẩu',
      INCOME_PROOF: 'Bảng lương/Xác nhận thu nhập',
      BANK_STATEMENT: 'Sao kê ngân hàng',
      LABOR_CONTRACT: 'Hợp đồng lao động',
      BUSINESS_LICENSE: 'Giấy phép kinh doanh',
      BUSINESS_PHOTO: 'Ảnh cơ sở kinh doanh',
      VEHICLE_CONTRACT: 'Hợp đồng mua xe',
      DEPOSIT_RECEIPT: 'Biên nhận đặt cọc',
      ASSET_DOCUMENT: 'Giấy tờ tài sản',
      OTHER: 'Tài liệu khác',
    };
    return map[key] || key || 'Không xác định';
  }

  function isObj(v) { return !!v && typeof v === 'object' && !Array.isArray(v); }
  function toRows(obj) {
    if (!isObj(obj)) return [];
    return Object.entries(obj).filter(([_, v]) => v !== null && v !== undefined && v !== '');
  }

  let allDocs = Array.isArray(docsJson.allDocuments) ? docsJson.allDocuments.slice() : [];
  if (allDocs.length === 0 && isObj(docsJson.byType)) {
    Object.entries(docsJson.byType).forEach(([type, urls]) => {
      if (!Array.isArray(urls)) return;
      urls.forEach((u) => allDocs.push({ type, url: u }));
    });
  }
  if (allDocs.length === 0) {
    if (app.cccdUrl) allDocs.push({ type: 'CCCD_FRONT', url: app.cccdUrl, fileName: 'CCCD' });
    if (app.incomeProofUrl) allDocs.push({ type: 'INCOME_PROOF', url: app.incomeProofUrl, fileName: 'Chứng minh thu nhập' });
    if (app.contractUrl) allDocs.push({ type: 'VEHICLE_CONTRACT', url: app.contractUrl, fileName: 'Hợp đồng' });
  }

  const step1 = snapshot.step1Personal || {};
  const step2 = snapshot.step2Occupation || {};
  const step3 = snapshot.step3Finance || {};
  const step4 = snapshot.step4Loan || {};
  const step5 = snapshot.step5Documents || {};
  const step6 = snapshot.step6Commitment || {};
  const step7 = snapshot.step7Confirmation || {};
  const vehicle = snapshot.vehicle || {};
%>

<div class="mb-6">
  <a href="/admin" class="inline-flex items-center gap-2 text-sm font-medium text-indigo-600 hover:text-indigo-800">
    <span>←</span>
    <span>Quay lại bảng điều khiển</span>
  </a>
</div>

<div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden mb-6">
  <div class="px-6 py-5 border-b border-slate-200 bg-slate-50">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h1 class="text-xl font-bold text-slate-900">Chi tiết hồ sơ vay</h1>
        <p class="text-xs text-slate-500 font-mono mt-1">ID: <%= app.id %></p>
      </div>
      <span class="px-3 py-1 rounded-full text-sm font-semibold border
        <%= app.status === 'PENDING' ? 'bg-amber-100 text-amber-800 border-amber-200' : '' %>
        <%= app.status === 'APPROVED' ? 'bg-emerald-100 text-emerald-800 border-emerald-200' : '' %>
        <%= app.status === 'REJECTED' ? 'bg-red-100 text-red-800 border-red-200' : '' %>">
        <%= app.status %>
      </span>
    </div>
  </div>

  <div class="p-6">
    <h2 class="text-base font-semibold text-slate-900 mb-3">Thông tin cơ bản</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
      <div class="p-3 bg-slate-50 rounded border border-slate-200"><span class="text-slate-500">Khách hàng:</span> <b><%= app.customerName || '-' %></b></div>
      <div class="p-3 bg-slate-50 rounded border border-slate-200"><span class="text-slate-500">CCCD:</span> <b><%= app.cccd || '-' %></b></div>
      <div class="p-3 bg-slate-50 rounded border border-slate-200"><span class="text-slate-500">Điện thoại:</span> <b><%= app.phone || '-' %></b></div>
      <div class="p-3 bg-slate-50 rounded border border-slate-200"><span class="text-slate-500">Số tiền vay:</span> <b><%= typeof app.amount !== 'undefined' ? new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(app.amount) : '-' %></b></div>
      <div class="p-3 bg-slate-50 rounded border border-slate-200"><span class="text-slate-500">Kỳ hạn:</span> <b><%= app.term || '-' %> tháng</b></div>
      <div class="p-3 bg-slate-50 rounded border border-slate-200"><span class="text-slate-500">External ID:</span> <b><%= app.externalId || '-' %></b></div>
    </div>
  </div>
</div>

<div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden mb-6">
  <div class="px-6 py-4 border-b border-slate-200 bg-slate-50">
    <h2 class="text-base font-semibold text-slate-900">Tài liệu nhận từ backend (<%= allDocs.length %>)</h2>
  </div>
  <div class="p-6">
    <% if (allDocs.length === 0) { %>
      <p class="text-sm text-slate-500">Chưa có tài liệu.</p>
    <% } else { %>
      <div class="space-y-2">
        <% allDocs.forEach((d, idx) => { %>
          <div class="border border-slate-200 rounded-lg p-3 flex items-center justify-between gap-3">
            <div class="min-w-0">
              <p class="text-sm font-semibold text-slate-900"><%= toLabel(d.type) %></p>
              <p class="text-xs text-slate-500 truncate">
                <%= d.fileName || ('Tài liệu #' + (idx + 1)) %>
                <% if (d.uploadedAt) { %> • <%= d.uploadedAt %><% } %>
              </p>
            </div>
            <a href="<%= d.url %>" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-indigo-600 hover:text-indigo-800 whitespace-nowrap">Xem →</a>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden mb-6">
  <div class="px-6 py-4 border-b border-slate-200 bg-slate-50">
    <h2 class="text-base font-semibold text-slate-900">Snapshot dữ liệu 7 bước</h2>
  </div>
  <div class="p-6 space-y-6">
    <div>
      <h3 class="text-sm font-bold text-slate-800 mb-2">Bước 1 - Cá nhân</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm">
        <% toRows(step1).forEach(([k,v]) => { %><div class="p-2 bg-slate-50 rounded border border-slate-200"><span class="text-slate-500"><%= k %>:</span> <b><%= String(v) %></b></div><% }) %>
      </div>
    </div>
    <div>
      <h3 class="text-sm font-bold text-slate-800 mb-2">Bước 2 - Nghề nghiệp</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm">
        <% toRows(step2).forEach(([k,v]) => { %><div class="p-2 bg-slate-50 rounded border border-slate-200"><span class="text-slate-500"><%= k %>:</span> <b><%= String(v) %></b></div><% }) %>
      </div>
    </div>
    <div>
      <h3 class="text-sm font-bold text-slate-800 mb-2">Bước 3 - Tài chính</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm">
        <% toRows(step3).forEach(([k,v]) => { %><div class="p-2 bg-slate-50 rounded border border-slate-200"><span class="text-slate-500"><%= k %>:</span> <b><%= String(v) %></b></div><% }) %>
      </div>
    </div>
    <div>
      <h3 class="text-sm font-bold text-slate-800 mb-2">Bước 4 - Khoản vay</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm">
        <% toRows(step4).forEach(([k,v]) => { %><div class="p-2 bg-slate-50 rounded border border-slate-200"><span class="text-slate-500"><%= k %>:</span> <b><%= String(v) %></b></div><% }) %>
      </div>
    </div>
    <div>
      <h3 class="text-sm font-bold text-slate-800 mb-2">Bước 5 - Tài liệu</h3>
      <pre class="text-xs bg-slate-50 border border-slate-200 rounded p-3 overflow-auto"><%= JSON.stringify(step5, null, 2) %></pre>
    </div>
    <div>
      <h3 class="text-sm font-bold text-slate-800 mb-2">Bước 6 - Cam kết & chữ ký</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm">
        <% toRows(step6).forEach(([k,v]) => { %><div class="p-2 bg-slate-50 rounded border border-slate-200"><span class="text-slate-500"><%= k %>:</span> <b><%= String(v) %></b></div><% }) %>
      </div>
      <% if (step6.signatureUrl) { %>
        <div class="mt-2">
          <a href="<%= step6.signatureUrl %>" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-indigo-600 hover:text-indigo-800">Mở chữ ký →</a>
        </div>
      <% } %>
    </div>
    <div>
      <h3 class="text-sm font-bold text-slate-800 mb-2">Bước 7 - Xác nhận</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm">
        <% toRows(step7).forEach(([k,v]) => { %><div class="p-2 bg-slate-50 rounded border border-slate-200"><span class="text-slate-500"><%= k %>:</span> <b><%= String(v) %></b></div><% }) %>
      </div>
    </div>
    <div>
      <h3 class="text-sm font-bold text-slate-800 mb-2">Vehicle snapshot</h3>
      <pre class="text-xs bg-slate-50 border border-slate-200 rounded p-3 overflow-auto"><%= JSON.stringify(vehicle, null, 2) %></pre>
    </div>
  </div>
</div>

<% if (app.status === 'REJECTED') { %>
  <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-6">
    <p class="text-sm text-red-700"><b>Lý do từ chối:</b> <%= reasonLabels[app.reasonCode] || app.reasonCode || '-' %></p>
    <% if (app.note) { %><p class="text-sm text-red-700 mt-1"><b>Ghi chú:</b> <%= app.note %></p><% } %>
  </div>
<% } %>

<% if (app.status === 'PENDING') { %>
<div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
  <div class="px-6 py-5">
    <h2 class="text-base font-semibold text-slate-900 mb-4">Quyết định phê duyệt</h2>
    <div class="flex flex-col sm:flex-row gap-3">
      <form action="/admin/<%= app.id %>/action" method="POST">
        <input type="hidden" name="action" value="APPROVE">
        <button type="submit" class="px-5 py-2.5 rounded-lg bg-emerald-600 text-white font-semibold hover:bg-emerald-700">Phê duyệt hồ sơ</button>
      </form>

      <button type="button" onclick="document.getElementById('rejectForm').classList.toggle('hidden')" class="px-5 py-2.5 rounded-lg border border-red-300 text-red-700 font-semibold hover:bg-red-50">Từ chối hồ sơ</button>
    </div>

    <form id="rejectForm" action="/admin/<%= app.id %>/action" method="POST" class="hidden mt-5 border-t border-slate-200 pt-5">
      <input type="hidden" name="action" value="REJECT">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label for="reasonCode" class="block text-sm font-medium text-slate-700 mb-1">Lý do từ chối *</label>
          <select id="reasonCode" name="reasonCode" required class="block w-full rounded-lg border border-slate-300 bg-white py-2 px-3 text-sm">
            <option value="">Chọn lý do...</option>
            <% reasonCodes.forEach(code => { %>
              <option value="<%= code %>"><%= reasonLabels[code] %></option>
            <% }) %>
          </select>
        </div>
        <div class="sm:col-span-2">
          <label for="note" class="block text-sm font-medium text-slate-700 mb-1">Ghi chú thêm</label>
          <textarea id="note" name="note" rows="3" class="block w-full rounded-lg border border-slate-300 bg-white py-2 px-3 text-sm"></textarea>
        </div>
      </div>
      <div class="mt-4">
        <button type="submit" class="px-5 py-2.5 rounded-lg bg-red-600 text-white font-semibold hover:bg-red-700">Xác nhận từ chối</button>
      </div>
    </form>
  </div>
</div>
<% } %>
